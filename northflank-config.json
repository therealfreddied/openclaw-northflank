{
  "agents": {
    "defaults": {
      "model": "cloudflare/google-ai-studio/gemini-3.7-flash",
      "provider": "cloudflare"
    }
  },
  "providers": {
    "cloudflare": {
      "api_key": "${CLOUDFLARE_AI_GATEWAY_KEY}",
      "api_base": "https://gateway.ai.cloudflare.com/v1/c03418af811230a17c32686972c400fc/openclaw/v1"
    }
  },
  "gateway": {
    "host": "0.0.0.0",
    "port": 18790
  },
  "channels": {
    "websocket": {
      "enabled": true,
      "host": "0.0.0.0",
      "port": 8765,
      "tokenIssueSecret": "${NANOBOT_WEB_TOKEN}",
      "websocketRequiresToken": true
    }
  }
}
